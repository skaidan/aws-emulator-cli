              },
              "total": {
                "type": "integer"
              }
            }
          },
          "to": {
            "type": "object",
            "required": [
              "passed",
              "total"
            ],
            "properties": {
              "passed": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "fixed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regressed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "added_passing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "added_failing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "removed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
